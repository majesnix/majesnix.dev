---
import "@fontsource/roboto-slab/700.css";
import fontUrl from "@fontsource/roboto-slab/files/roboto-slab-latin-700-normal.woff2?url";
import "../styles/global.css";

import Avatar from "../components/Avatar.astro";
import Footer from "../components/Footer.astro";
import GithubLink from "../components/GithubLink.astro";
import Hero from "../components/Hero.astro";
import Tags from "../components/Tags.astro";
import { profile } from "../content";

const title = `${profile.name} · ${profile.role}`;
const canonical = new URL("/", Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
const ogImageAlt = "A small white hamster on a wooden ramp, mid-snack.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#121212" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#f09200" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#121212" />
    <meta name="application-name" content="dominic-classen.de" />
    <meta name="apple-mobile-web-app-title" content="dominic-classen.de" />

    <!-- Link previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={profile.description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <main>
      <Hero />
      <section class="card">
        <Avatar />
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <GithubLink />
        <p class="intro">{profile.intro}</p>
        <Tags />
      </section>
      <Footer />
    </main>

    <script is:inline>
      console.log(`%c
  __  __       _           _   _ _       ​
 |  \\/  |     (_)         | \\ | (_)      ​
 | \\  / | __ _ _  ___  ___|  \\| |___  __ ​
 | |\\/| |/ _\` | |/ _ \\/ __| . \` | \\ \\/ / ​
 | |  | | (_| | |  __/\\__ \\ |\\  | |>  <  ​
 |_|  |_|\\__,_| |\\___||___/_| \\_|_/_/\\_\\ ​
             _/ |                        ​
            |__/                         ​​`, 'background:#121212;color:#0f0')
    </script>
  </body>
</html>

<style>
  main {
    min-height: 100vh;
    padding-bottom: 48px;
    background-color: var(--bg);
  }

  .card {
    position: relative;
    width: min(100% - 48px, 820px);
    margin: -40px auto 0;
    padding: 0 32px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
  }

  /* Staggered entrance: each child of the card rises 70ms after the previous one. */
  .card > :global(*) {
    animation: rise 600ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }
  .card > :global(:nth-child(2)) { --i: 1; }
  .card > :global(:nth-child(3)) { --i: 2; }
  .card > :global(:nth-child(4)) { --i: 3; }
  .card > :global(:nth-child(5)) { --i: 4; }
  .card > :global(:nth-child(6)) { --i: 5; }

  h1 {
    margin: 24px 0 6px;
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .role {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .intro {
    max-width: 560px;
    margin: 20px auto 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .card {
      width: calc(100% - 32px);
      padding: 0 20px 32px;
    }
  }
</style>
