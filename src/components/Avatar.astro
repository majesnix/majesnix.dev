---
import { Picture } from "astro:assets";

import avatar from "../assets/images/dcl.png";
---

<div class="medallion">
  <Picture
    src={avatar}
    formats={["avif", "webp"]}
    widths={[160, 320]}
    sizes="160px"
    alt=""
    loading="eager"
  />
</div>

<style>
  .medallion {
    width: var(--coin-size);
    height: var(--coin-size);
    margin-top: calc(var(--coin-size) / -2);
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--surface-raised);
    box-shadow:
      0 0 0 4px var(--surface),
      0 0 0 5px var(--border-strong),
      0 18px 36px -14px rgba(0, 0, 0, 0.8);
  }

  .medallion :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
