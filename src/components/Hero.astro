---
import { Picture } from "astro:assets";

import hero from "../assets/images/chibi.jpg";

const HERO_ALT = "A small white hamster on a wooden ramp, mid-snack.";
---

<div class="frame">
  <Picture
    src={hero}
    formats={["avif", "webp"]}
    widths={[640, 1024, 1440]}
    sizes="100vw"
    alt={HERO_ALT}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .frame {
    position: relative;
    height: var(--hero-height);
    overflow: hidden;
    background-color: var(--surface);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  /* Dissolve the photo into the page so the card rises out of it. */
  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(18, 18, 18, 0) 40%,
      rgba(18, 18, 18, 0.55) 78%,
      var(--bg) 100%
    );
  }

  @media (max-width: 768px) {
    .frame :global(img) {
      object-position: 47% 50%;
    }
  }
</style>
